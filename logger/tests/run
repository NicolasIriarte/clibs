#!/bin/bash
#
# Checks what logger.h actually prints, rather than only that its example exits 0.
#
# Usage: logger/tests/run
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

CC="${CC:-cc}"
read -ra cflags <<<"${CFLAGS:--std=c11 -Wall -Wextra -Werror}"

failures=0

# expect <description> <output> <line that must be in it, whole>
expect() {
	if grep -qxF -- "$3" <<<"$2"; then
		echo "ok   $1"
	else
		echo "FAIL $1: expected the line: $3"
		failures=$((failures + 1))
	fi
}

# refuse <description> <output> <text that must not be in it>
refuse() {
	if grep -qF -- "$3" <<<"$2"; then
		echo "FAIL $1: did not expect: $3"
		failures=$((failures + 1))
	else
		echo "ok   $1"
	fi
}

# Colors compiled out, so the assertions below read as plain text.
no_color=(-DCOLOR_DEFAULT='""' -DCOLOR_SEAGREEN='""' -DCOLOR_WHITE='""' -DCOLOR_GREEN='""'
	-DCOLOR_YELLOW='""' -DCOLOR_RED='""')

"$CC" "${cflags[@]}" "${no_color[@]}" -I"$here/.." "$here/vars.c" -o "$work/vars"
out="$("$work/vars")"

expect "a char prints as its character" "$out" "  c = 'A' (0x41)"
expect "a negative signed char prints at its own width" "$out" "  sc = -1 (0xFF)"
expect "a negative short prints at its own width" "$out" "  sh = -2 (0xFFFE)"
expect "an unsigned long long prints in full" "$out" "  ull = 18446744073709551615 (0xffffffffffffffff)"
expect "a bool prints as a word" "$out" "  b = true (0x01)"
refuse "log_misc honours an expression as its level" "$out" "misc above the trace level"
expect "log_misc prints at or below the trace level" "$out" \
	"[MISC] [$here/vars.c:17] - misc below the trace level"

"$CC" "${cflags[@]}" "${no_color[@]}" -DLOGGER_INFO_ENABLED=0 -I"$here/.." "$here/vars.c" -o "$work/quiet"
out="$("$work/quiet")"

refuse "log_debug_vars prints no heading with INFO disabled" "$out" " - vars"
refuse "log_debug_vars prints no variables with INFO disabled" "$out" " = "

# streams ends in log_halt, which exits 1.
"$CC" "${cflags[@]}" "${no_color[@]}" -I"$here/.." "$here/streams.c" -o "$work/streams"
out="$("$work/streams" 2>/dev/null || true)"
errors="$("$work/streams" 2>&1 >/dev/null || true)"

expect "log_info prints to stdout" "$out" "[INFO] [$here/streams.c:11] - info"
expect "log_warn prints to stdout" "$out" "[WARN] [$here/streams.c:13] - warn"
expect "log_misc prints to stdout" "$out" "[MISC] [$here/streams.c:15] - misc"
expect "log_base prints to stdout" "$out" "base"
expect "log_base_raw prints to stdout" "$out" "raw"
expect "log_debug_vars prints to stdout" "$out" "  opaque = <unknown type>"
refuse "log_fail prints nothing to stdout" "$out" "[FAIL]"
refuse "log_halt prints nothing to stdout" "$out" "[HALT]"

expect "log_fail prints to stderr" "$errors" "[FAIL] [$here/streams.c:14] - fail"
expect "log_halt prints to stderr" "$errors" "[HALT] [$here/streams.c:21] - halt"
others="$(grep -cvE '^\[(FAIL|HALT)\] ' <<<"$errors" || true)"
expect "only log_fail and log_halt print to stderr" "$others" "0"

# Into a pipe, where stdout is buffered and stderr is not: each has to flush what came before it.
out="$("$work/streams" 2>&1 || true)"
expect "log_fail comes after what stdout already holds" "${out%%\[FAIL\]*}" \
	"[WARN] [$here/streams.c:13] - warn"
expect "log_halt comes after what stdout already holds" "${out%%\[HALT\]*}" "base"

if [[ "$failures" -ne 0 ]]; then
	echo "$failures check(s) failed"
	exit 1
fi
