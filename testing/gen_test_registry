#!/bin/bash
#
# Writes the list of user stories the test suite registers, from the story files that exist.
#
# Usage: gen_test_registry <test-dir> <output-header>
#
# Generated rather than self-registering through constructors: the order is then the order of the files,
# rather than whatever the linker chose, and there is one place to look to see what will run. Every story
# used to be added by hand to a list in the test entrypoint -- every branch that added a test touched the
# same line, and a careless merge could silently drop a story with nothing to catch it. Generating the
# list from the files themselves removes that entirely.
#
# Honours TESTSUITE_STORIES, a comma-separated list, to build a subset:
#
#   TESTSUITE_STORIES=4,7 gen_test_registry test build/inc/testsuite_registry.h
set -euo pipefail

test_dir="${1:?usage: gen_test_registry <test-dir> <output-header>}"
out="${2:?usage: gen_test_registry <test-dir> <output-header>}"
mkdir -p "$(dirname "$out")"

# The id is the filename's own leading number, kept exactly as written: the registration functions are
# named after it, and '04' is not '4'.
mapfile -t ids < <(
	find "$test_dir" -maxdepth 1 -name '[0-9]*_*.c' -printf '%f\n' \
		| sed 's/_.*//' \
		| sort -n
)

wanted="${TESTSUITE_STORIES:-}"
selected=()
for id in "${ids[@]}"; do
	if [[ -n "$wanted" ]]; then
		# Compared as numbers, so 04 and 4 both select the same story.
		keep=""
		IFS=',' read -ra asked <<<"$wanted"
		for one in "${asked[@]}"; do
			if [[ "$((10#$id))" == "$((10#${one// /}))" ]]; then keep=1; fi
		done
		[[ -n "$keep" ]] || continue
	fi
	selected+=("$id")
done

{
	echo "#pragma once"
	echo
	echo "/* Generated by gen_test_registry -- do not edit by hand."
	echo " *"
	echo " * One entry per ${test_dir}/NN_*.c. See that script for why this is generated."
	if [[ -n "$wanted" ]]; then
		echo " *"
		echo " * Built for a subset: TESTSUITE_STORIES=${wanted}"
	fi
	echo " */"
	echo
	echo "#define TESTSUITE_USER_STORY_COUNT (${#selected[@]})"
	echo
	echo "/* Called with a macro taking one story id. */"
	printf '#define TESTSUITE_USER_STORIES(X)'
	for id in "${selected[@]}"; do
		printf ' \\\n  X(%s)' "$id"
	done
	echo
} >"$out"

if [[ -n "$wanted" ]]; then
	echo "warning: test registry built for a subset only: ${selected[*]}" >&2
fi
